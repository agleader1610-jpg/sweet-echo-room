<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Kept for backward compat / MainActivity control; hidden from UI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_url"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"/>

            <Button
                android:id="@+id/goBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_go"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/relayToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ws_relay"/>

            <EditText
                android:id="@+id/relayProxyInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_ws_relay"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:singleLine="true"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:visibility="gone"/>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- ═════ EIP compact overlay pinned to top of Browser tab ═════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/vipOverlay"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F00B1220"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Header: brand + drag handle + close + W/L score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/overlayDragHandle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ EIP TEAM"
                    android:textColor="#FFD54F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.24"
                    android:shadowColor="#66FFD54F"
                    android:shadowRadius="6"/>
                <TextView
                    android:id="@+id/overlayScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:background="#1F2937"
                    android:text="0W-0L"
                    android:textColor="#4ADE80"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                <TextView
                    android:id="@+id/overlayClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="2dp"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Phase + big live multiplier -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/overlayPhase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="#4CAF50"
                    android:text="BET NOW"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16"/>
                <TextView
                    android:id="@+id/overlayLive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:text="—"
                    android:textColor="#FACC15"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Previous round -->
            <TextView
                android:id="@+id/overlayPrev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="prev —"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:fontFamily="monospace"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="7dp"
                android:background="#1E293B"/>

            <!-- Signal FOR next round -->
            <TextView
                android:id="@+id/overlaySignal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="#1F2937"
                android:text="◈ ANALYZING…"
                android:textColor="#FACC15"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- Last resolved result -->
            <TextView
                android:id="@+id/overlayResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="#1F2937"
                android:text="◌ WAIT"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"/>

            <!-- Scrolling history marquee -->
            <TextView
                android:id="@+id/overlayHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="#0B1220"
                android:text=""
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Loading overlay: "Connecting EIP Team..." -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/loadingLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_eip_round"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Connecting EIP Team"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/loadingDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="•  •  •"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:letterSpacing="0.4"/>

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/primary_glow"/>
    </LinearLayout>
</FrameLayout>
