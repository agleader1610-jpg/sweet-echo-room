<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Kept for backward compat / MainActivity control; hidden from UI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_url"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"/>

            <Button
                android:id="@+id/goBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_go"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/relayToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ws_relay"/>

            <EditText
                android:id="@+id/relayProxyInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_ws_relay"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:singleLine="true"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:visibility="gone"/>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- ═════ EIP signal overlay pinned to top of Browser tab ═════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/vipOverlay"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F00A1226"
        app:cardCornerRadius="10dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/overlayDragHandle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ EIP"
                    android:textColor="#22D3EE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"/>
                <TextView
                    android:id="@+id/overlayScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp" android:paddingEnd="5dp"
                    android:background="#1F2937"
                    android:text=""
                    android:textColor="#4ADE80"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_mono"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/overlayClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/overlayPhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SIGNAL • #—"
                android:textColor="#94A3B8"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:fontFamily="@font/roboto_mono"/>

            <TextView
                android:id="@+id/overlayLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#4ADE80"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/orbitron"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"/>

            <TextView
                android:id="@+id/overlaySignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingStart="7dp" android:paddingEnd="7dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"
                android:background="#455A64"
                android:text="ANALYZING"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/overlayPrev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="LAST —"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:fontFamily="@font/roboto_mono"/>

            <TextView
                android:id="@+id/overlayResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="5dp" android:paddingEnd="5dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"
                android:background="#1F2937"
                android:text="◌ WAIT"
                android:textColor="#94A3B8"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/overlayHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:paddingStart="5dp" android:paddingEnd="5dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:background="#0B1220"
                android:text=""
                android:textSize="9sp"
                android:fontFamily="@font/roboto_mono"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <!-- ═════ EIP WIN GO overlay (compact) ═════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/wingoOverlay"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F00A1226"
        app:cardCornerRadius="10dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ EIP • WIN GO"
                    android:textColor="#22D3EE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"/>
                <TextView
                    android:id="@+id/wingoOverlayScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp" android:paddingEnd="5dp"
                    android:background="#1F2937"
                    android:text=""
                    android:textColor="#4ADE80"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_mono"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/wingoOverlayClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp">
                <TextView
                    android:id="@+id/wingoOverlayPeriod"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="#—"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:fontFamily="@font/roboto_mono"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/wingoOverlayCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp" android:paddingEnd="6dp"
                    android:paddingTop="1dp" android:paddingBottom="1dp"
                    android:background="#0A0F1E"
                    android:text="—:—"
                    android:textColor="#4ADE80"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_mono"/>
            </LinearLayout>

            <TextView
                android:id="@+id/wingoOverlayPick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.05"
                android:background="#334155"/>

            <TextView
                android:id="@+id/wingoOverlayConfidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="—"
                android:textColor="#94A3B8"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.16"/>

            <TextView
                android:id="@+id/wingoOverlayResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="5dp" android:paddingEnd="5dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"
                android:background="#1F2937"
                android:text="◌ WAIT"
                android:textColor="#94A3B8"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/wingoOverlayHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:paddingStart="5dp" android:paddingEnd="5dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:background="#0B1220"
                android:text=""
                android:textSize="9sp"
                android:fontFamily="@font/roboto_mono"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <!-- Loading overlay: "Connecting EIP Team..." -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/loadingLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_eip_round"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Connecting EIP Team"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/loadingDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="•  •  •"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:letterSpacing="0.4"/>

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/primary_glow"/>
    </LinearLayout>
</FrameLayout>
