<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Kept for backward compat / MainActivity control; hidden from UI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_url"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"/>

            <Button
                android:id="@+id/goBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_go"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/relayToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ws_relay"/>

            <EditText
                android:id="@+id/relayProxyInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_ws_relay"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:singleLine="true"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:visibility="gone"/>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- ═════ EIP AVIATOR overlay (wide compact) ═════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/vipOverlay"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/overlay_card_bg"
            android:padding="8dp">

            <!-- Header: brand pill + score + close -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/overlayDragHandle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/overlay_brand_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="⚡ EIP TEAM"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"
                    android:shadowColor="#8022D3EE"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="6"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="AVIATOR"
                    android:textColor="#22D3EE"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.28"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/overlayScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp" android:paddingEnd="5dp"
                    android:background="#1F2937"
                    android:text=""
                    android:textColor="#4ADE80"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_mono"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/overlayClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Hero row: big multiplier LEFT, meta stack RIGHT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp"
                android:background="@drawable/overlay_hero_bg"
                android:padding="8dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.15"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/overlayPhase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIGNAL • #—"
                        android:textColor="#64748B"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"
                        android:fontFamily="@font/roboto_mono"/>
                    <TextView
                        android:id="@+id/overlayLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#4ADE80"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/overlaySignal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:background="#455A64"
                        android:text="ANALYZING"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14"/>

                    <TextView
                        android:id="@+id/overlayResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingStart="6dp" android:paddingEnd="6dp"
                        android:paddingTop="2dp" android:paddingBottom="2dp"
                        android:background="#1F2937"
                        android:text="◌ WAIT"
                        android:textColor="#94A3B8"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Footer: last + history strip -->
            <TextView
                android:id="@+id/overlayPrev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="LAST —"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:fontFamily="@font/roboto_mono"/>

            <TextView
                android:id="@+id/overlayHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="6dp" android:paddingEnd="6dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:background="#0B1220"
                android:text=""
                android:textSize="9sp"
                android:fontFamily="@font/roboto_mono"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <!-- ═════ EIP WIN GO overlay (wide compact) ═════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/wingoOverlay"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/overlay_card_bg"
            android:padding="8dp">

            <!-- Header: brand pill + subtitle + close -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/overlay_brand_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="⚡ EIP TEAM"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"
                    android:shadowColor="#8022D3EE"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="6"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="WIN GO"
                    android:textColor="#22D3EE"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.28"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/wingoOverlayScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp" android:paddingEnd="5dp"
                    android:background="#1F2937"
                    android:text=""
                    android:textColor="#4ADE80"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_mono"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/wingoOverlayClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Hero row: PICK big LEFT, period+countdown+confidence RIGHT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp"
                android:background="@drawable/overlay_hero_bg"
                android:padding="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/wingoOverlayPick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.15"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/orbitron"
                    android:letterSpacing="0.06"
                    android:background="#334155"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/wingoOverlayPeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#—"
                        android:textColor="#94A3B8"
                        android:textSize="9sp"
                        android:fontFamily="@font/roboto_mono"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/wingoOverlayCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="2dp" android:paddingBottom="2dp"
                        android:background="#0A0F1E"
                        android:text="—:—"
                        android:textColor="#4ADE80"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto_mono"/>

                    <TextView
                        android:id="@+id/wingoOverlayConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="—"
                        android:textColor="#94A3B8"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.16"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/wingoOverlayResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="6dp" android:paddingEnd="6dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"
                android:background="#1F2937"
                android:text="◌ WAIT"
                android:textColor="#94A3B8"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/wingoOverlayHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="6dp" android:paddingEnd="6dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:background="#0B1220"
                android:text=""
                android:textSize="9sp"
                android:fontFamily="@font/roboto_mono"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>



    <!-- Loading overlay: "Connecting EIP Team..." -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/loadingLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_eip_round"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Connecting EIP Team"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:id="@+id/loadingDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="•  •  •"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:letterSpacing="0.4"/>

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/primary_glow"/>
    </LinearLayout>
</FrameLayout>
