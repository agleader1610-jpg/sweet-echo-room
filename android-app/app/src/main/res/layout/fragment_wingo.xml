<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060912"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">
            <View android:layout_width="4dp" android:layout_height="22dp" android:background="#FFD54F"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="EIP TEAM • WIN GO 30S"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.28"/>
            <Button
                android:id="@+id/clearBtn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESET"
                android:textSize="10sp"
                android:textColor="#94A3B8"/>
        </LinearLayout>

        <!-- Countdown + Period -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0A1428"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT PERIOD"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.24"/>
                    <TextView
                        android:id="@+id/currentPeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#—"
                        android:textColor="#E2E8F0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIME LEFT"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.24"
                        android:layout_gravity="end"/>
                    <TextView
                        android:id="@+id/countdownText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—:—"
                        android:textColor="#4ADE80"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Signal Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/signalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0A1428"
            app:cardCornerRadius="16dp"
            app:cardElevation="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View android:layout_width="3dp" android:layout_height="14dp" android:background="#FFD54F"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="EIP SIGNAL"
                        android:textColor="#FFD54F"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.3"/>
                    <TextView
                        android:id="@+id/predConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:background="#1F2937"
                        android:text="—"
                        android:textColor="#E2E8F0"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/predForIssue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="PERIOD  #—"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/predCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="BET ON —"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"/>

                <TextView
                    android:id="@+id/predPick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:background="#334155"/>

                <TextView
                    android:id="@+id/predReasoning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="#94A3B8"
                    android:textSize="11sp"/>

                <!-- Scoreboard -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:background="#0B1A33"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/winsText"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="#4ADE80"
                            android:textSize="22sp" android:textStyle="bold"
                            android:fontFamily="sans-serif-black"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="WINS" android:textColor="#4ADE80"
                            android:textSize="8sp" android:textStyle="bold"
                            android:letterSpacing="0.2"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1E293B"/>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/lossesText"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="#F87171"
                            android:textSize="22sp" android:textStyle="bold"
                            android:fontFamily="sans-serif-black"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="LOSS" android:textColor="#F87171"
                            android:textSize="8sp" android:textStyle="bold"
                            android:letterSpacing="0.2"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1E293B"/>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/accuracyText"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="#FFD54F"
                            android:textSize="22sp" android:textStyle="bold"
                            android:fontFamily="sans-serif-black"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ACC" android:textColor="#FFD54F"
                            android:textSize="8sp" android:textStyle="bold"
                            android:letterSpacing="0.2"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Last result badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:id="@+id/lastResultBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="4dp" android:paddingBottom="4dp"
                        android:background="#1F2937"
                        android:text="—"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/lastResultDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- History -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="RECENT RESULTS"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.24"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/historyStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🔴 RED = 2,4,6,8   🟢 GREEN = 1,3,7,9   🟣 VIOLET = 0,5"
            android:textColor="#546A85"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:gravity="center"/>

        <!-- Browser-tab overlay toggle -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#0A1428"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BROWSER TAB OVERLAY"
                        android:textColor="#FFD54F"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.2"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Show WIN GO signal card on the game screen (auto-disables Aviator overlay)"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/overlaySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
