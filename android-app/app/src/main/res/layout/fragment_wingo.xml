<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">
            <View android:layout_width="4dp" android:layout_height="22dp" android:background="#22D3EE"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="EIP TEAM • WIN GO 30S"
                android:textColor="#22D3EE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.28"/>
            <Button
                android:id="@+id/clearBtn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESET"
                android:textSize="10sp"
                android:textColor="#94A3B8"/>
        </LinearLayout>

        <!-- Browser-tab overlay toggle (moved to top) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#111C33"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BROWSER TAB OVERLAY"
                        android:textColor="#22D3EE"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.2"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Show WIN GO signal card on the game screen (auto-disables Aviator overlay)"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/overlaySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Signal source selector: AI (smart) or Server (random). Mutually exclusive. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_signal_source_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ SIGNAL SOURCE"
                        android:textColor="#22D3EE"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.25"/>
                    <TextView
                        android:id="@+id/signalSourceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● LIVE"
                        android:textColor="#22D3EE"
                        android:textStyle="bold"
                        android:textSize="10sp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="একটাই on রাখুন — Auto-Bet (In-App)-এও একই signal যাবে।"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"/>

                <!-- AI SIGNAL option -->
                <LinearLayout
                    android:id="@+id/aiSignalRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_signal_option_ai">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_ai_live"
                        android:layout_marginEnd="10dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Connected Gemini AI"
                                android:textColor="#E2E8F0"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="AI"
                                android:textColor="#0A0F1E"
                                android:textStyle="bold"
                                android:textSize="9sp"
                                android:background="@drawable/bg_ai_badge"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Neural market analysis · smart pick"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/aiSignalSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#22D3EE"
                        app:trackTint="#33334155"/>
                </LinearLayout>

                <!-- SERVER SIGNAL option -->
                <LinearLayout
                    android:id="@+id/serverSignalRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_signal_option_server">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_server_live"
                        android:layout_marginEnd="10dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Random Engine"
                                android:textColor="#E2E8F0"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="RNG"
                                android:textColor="#0A0F1E"
                                android:textStyle="bold"
                                android:textSize="9sp"
                                android:background="@drawable/bg_server_badge"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Per-device random pick · free"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/serverSignalSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#F59E0B"
                        app:trackTint="#33334155"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>


        <!-- Auto-Bet panel moved to its own tab (WinGoAutoBetFragment). -->

        <!-- Countdown + Period -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0A0F1E"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT PERIOD"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.24"/>
                    <TextView
                        android:id="@+id/currentPeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#—"
                        android:textColor="#E2E8F0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto_mono"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIME LEFT"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.24"
                        android:layout_gravity="end"/>
                    <TextView
                        android:id="@+id/countdownText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—:—"
                        android:textColor="#4ADE80"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Signal Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/signalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/signal_hero_frame"
                android:padding="16dp">

                <!-- Decorative corner ticks -->
                <View
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="4dp" android:layout_marginTop="4dp"
                    android:background="@drawable/signal_corner_tl"/>
                <View
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="4dp" android:layout_marginBottom="4dp"
                    android:background="@drawable/signal_corner_br"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <!-- Top row: LIVE pulse + label + confidence pill -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/status_dot_live"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="EIP SIGNAL  •  LIVE"
                            android:textColor="#22D3EE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.32"/>
                        <TextView
                            android:id="@+id/predConfidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp" android:paddingEnd="12dp"
                            android:paddingTop="5dp" android:paddingBottom="5dp"
                            android:background="@drawable/signal_pill_bg"
                            android:text="—"
                            android:textColor="#E2E8F0"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.22"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#1E2A44"/>

                    <!-- Period + category row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">
                        <TextView
                            android:id="@+id/predForIssue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PERIOD  #—"
                            android:textColor="#64748B"
                            android:textSize="10sp"
                            android:fontFamily="@font/roboto_mono"
                            android:letterSpacing="0.12"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/predCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BET ON —"
                            android:textColor="#A855F7"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.28"/>
                    </LinearLayout>

                    <!-- Hero pick block with layered glow -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_gravity="center"
                            android:background="@drawable/neon_hero_glow"
                            android:alpha="0.55"/>

                        <TextView
                            android:id="@+id/predPick"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="30dp"
                            android:paddingBottom="30dp"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="52sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/orbitron"
                            android:letterSpacing="0.14"
                            android:shadowColor="#AA000000"
                            android:shadowDx="0" android:shadowDy="3" android:shadowRadius="12"
                            android:background="@drawable/hero_neutral_gradient"
                            android:elevation="8dp"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/predReasoning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/module_card_bg"
                        android:text=""
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>

                    <!-- Scoreboard -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/module_card_bg"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/winsText"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="#4ADE80"
                                android:textSize="24sp" android:textStyle="bold"
                                android:fontFamily="@font/orbitron"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="WINS" android:textColor="#4ADE80"
                                android:textSize="9sp" android:textStyle="bold"
                                android:letterSpacing="0.24"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1E293B"/>
                        <LinearLayout
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/lossesText"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="#F87171"
                                android:textSize="24sp" android:textStyle="bold"
                                android:fontFamily="@font/orbitron"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="LOSS" android:textColor="#F87171"
                                android:textSize="9sp" android:textStyle="bold"
                                android:letterSpacing="0.24"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1E293B"/>
                        <LinearLayout
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/accuracyText"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0%" android:textColor="#22D3EE"
                                android:textSize="24sp" android:textStyle="bold"
                                android:fontFamily="@font/orbitron"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ACC" android:textColor="#22D3EE"
                                android:textSize="9sp" android:textStyle="bold"
                                android:letterSpacing="0.24"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Last result badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:id="@+id/lastResultBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp" android:paddingEnd="12dp"
                            android:paddingTop="5dp" android:paddingBottom="5dp"
                            android:background="#1F2937"
                            android:text="—"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/lastResultDetail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text=""
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:fontFamily="@font/roboto_mono"/>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- History -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="RECENT RESULTS"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.24"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/historyStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="BIG = 5-9   •   SMALL = 0-4"
            android:textColor="#546A85"
            android:textSize="9sp"
            android:fontFamily="@font/roboto_mono"
            android:gravity="center"/>

        <!-- Signal log (local only — stored in device SharedPreferences) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SIGNAL LOG  ·  ON-DEVICE"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.24"/>
            <Button
                android:id="@+id/logClearBtn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLEAR LOG"
                android:textSize="10sp"
                android:textColor="#94A3B8"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/signalLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
