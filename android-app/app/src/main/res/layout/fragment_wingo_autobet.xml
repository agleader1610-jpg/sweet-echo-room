<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">
            <View android:layout_width="4dp" android:layout_height="22dp" android:background="#F59E0B"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="EIP TEAM • WIN GO AUTO-BET"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.28"/>
        </LinearLayout>

        <!-- ================= AUTO-BET PANEL ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#0A1428"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🤖 AUTO-BET  •  AUTO MARKET"
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/autoBetSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Places bets via your phone's DK Win session — game/period auto-detected from captured API."
                    android:textColor="#64748B"
                    android:textSize="10sp"/>

                <!-- API Balance toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:padding="10dp"
                    android:background="@drawable/terminal_stat_bg">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="USE API BALANCE" android:textColor="#22D3EE" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.2"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ON = live API balance দিয়ে ladder\nOFF = নিচের manual balance দিয়ে ladder" android:textColor="#64748B" android:textSize="9sp"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/useApiBalanceSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Balance + Steps + Multiplier -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BALANCE ৳" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold"/>
                        <EditText android:id="@+id/balanceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="100" android:textColor="#22D3EE" android:textSize="14sp" android:background="@drawable/terminal_field_bg" android:padding="10dp" android:fontFamily="@font/roboto_mono"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STEPS (N)" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold"/>
                        <EditText android:id="@+id/stepsInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="7" android:textColor="#F59E0B" android:textSize="14sp" android:background="@drawable/terminal_field_bg" android:padding="10dp" android:fontFamily="@font/roboto_mono"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MULTIPLE" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold"/>
                        <EditText android:id="@+id/multInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="1" android:textColor="#A78BFA" android:textSize="14sp" android:background="@drawable/terminal_field_bg" android:padding="10dp" android:fontFamily="@font/roboto_mono"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="SIGNAL SOURCE"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.24"/>
                <TextView
                    android:id="@+id/abSignalSourceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:padding="11dp"
                    android:paddingStart="14dp"
                    android:background="@drawable/terminal_ticker_bg"
                    android:text="⚠️ WinGo Tab থেকে Signal Mode চালু করুন"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"
                    android:fontFamily="@font/roboto_mono"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="WinGo Tab-এ যে Signal on থাকবে, Auto-Bet সেই signal অনুযায়ীই bet দেবে।"
                    android:textColor="#64748B"
                    android:textSize="10sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RUN TIME (MIN)" android:textColor="#94A3B8" android:textSize="9sp" android:textStyle="bold"/>
                        <EditText android:id="@+id/durationInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="10" android:textColor="#22D3EE" android:textSize="14sp" android:background="@drawable/terminal_field_bg" android:padding="10dp" android:fontFamily="@font/roboto_mono"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/abTimerText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:padding="11dp"
                        android:paddingStart="14dp"
                        android:background="@drawable/terminal_ticker_bg"
                        android:text="Timer: OFF"
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        android:fontFamily="@font/roboto_mono"/>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/skipLowConfBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Skip LOW confidence signals"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E293B" android:layout_marginTop="12dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/abPlaced" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#E2E8F0" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PLACED" android:textColor="#64748B" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/abWon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#4ADE80" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WON" android:textColor="#4ADE80" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/abLost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#F87171" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOST" android:textColor="#F87171" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/abPnl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="৳0" android:textColor="#22D3EE" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P/L" android:textColor="#22D3EE" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/abNextBet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="11dp"
                    android:paddingStart="14dp"
                    android:background="@drawable/terminal_ticker_bg"
                    android:text="Trade: —"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:fontFamily="@font/roboto_mono"/>
                <TextView
                    android:id="@+id/abNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="4dp"
                    android:text=""
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:fontFamily="@font/roboto_mono"/>

                <Button
                    android:id="@+id/abResetStats"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="RESET STATS"
                    android:textColor="#64748B"
                    android:textSize="10sp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
