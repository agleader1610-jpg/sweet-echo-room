<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Draggable floating launcher button (plain ImageView so we can use any drawable) -->
    <ImageView
        android:id="@+id/launcherFab"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_eip_round"
        android:elevation="12dp"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Left-side notification bell with unread badge -->
    <FrameLayout
        android:id="@+id/bellWrap"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="28dp"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/bellIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🔔"
            android:textSize="24sp"
            android:background="@drawable/notif_bell_bg"/>

        <TextView
            android:id="@+id/bellBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:minWidth="20dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/notif_badge_bg"
            android:visibility="gone"/>
    </FrameLayout>
</FrameLayout>
