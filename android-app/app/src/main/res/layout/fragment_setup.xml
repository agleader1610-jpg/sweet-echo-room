<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">
            <View
                android:layout_width="4dp"
                android:layout_height="20dp"
                android:background="@drawable/section_bar_amber"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="⚙️  SETUP GUIDE"
                android:textColor="#22D3EE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.28"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="সেটআপ গাইড"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:text="যেকোনো কার্ডে ট্যাপ করলে ভিডিওটা অ্যাপের ভেতরেই বড় player-এ খুলবে। প্রতিটি প্যানেল কীভাবে সেট করবেন — ধাপে ধাপে দেখা যাবে।"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"/>

        <!-- CARD 1: Auto-Bet -->
        <LinearLayout
            android:id="@+id/playAutoBet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/module_card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/step_chip_amber"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖  STEP 1"
                    android:textColor="#FBBF24"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.24"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="Win Go Auto-Bet প্যানেল সেটআপ"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:text="অটো-বেট চালু করার আগে কীভাবে বেস অ্যামাউন্ট, টার্গেট প্রোফিট, মার্কেট আর টাইমার সেট করবেন — সম্পূর্ণ ধাপ এই ভিডিওতে দেখানো আছে।"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@drawable/video_thumb_amber">
                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/play_btn_circle_amber"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▶"
                    android:textColor="#1A0F00"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="HD  •  TUTORIAL"
                    android:textColor="#FBBF24"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:background="@drawable/step_chip_amber"/>
            </FrameLayout>
        </LinearLayout>

        <!-- CARD 2: WinGo -->
        <LinearLayout
            android:id="@+id/playWinGo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/module_card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/step_chip_cyan"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎲  STEP 2"
                    android:textColor="#67E8F9"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.24"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="Win Go সিগন্যাল সেটআপ"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:text="Win Go প্যানেলে সিগন্যাল কীভাবে দেখা যাবে, কোন পিরিয়ডে কোন কালার বা নাম্বার ধরতে হবে, ভয়েস এলার্ট চালু বা বন্ধ করা — সবকিছু এই ভিডিওতে সহজভাবে বুঝানো হয়েছে।"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@drawable/video_thumb_bg">
                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/play_btn_circle_cyan"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▶"
                    android:textColor="#062A33"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="HD  •  TUTORIAL"
                    android:textColor="#67E8F9"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:background="@drawable/step_chip_cyan"/>
            </FrameLayout>
        </LinearLayout>

        <!-- CARD 3: Aviator -->
        <LinearLayout
            android:id="@+id/playAviator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/module_card_bg"
            android:padding="14dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/step_chip_violet"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✈  STEP 3"
                    android:textColor="#C4B5FD"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.24"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="Aviator সিগন্যাল সেটআপ"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:text="Aviator প্যানেলে Bed Time আর Flying Time কীভাবে কাজ করে, কখন বেট বসাতে হবে, কখন cash-out করতে হবে — এই ভিডিওটা একবার শেষ পর্যন্ত দেখলে পুরো সিস্টেম ক্লিয়ার হয়ে যাবে।"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@drawable/video_thumb_violet">
                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/play_btn_circle_violet"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▶"
                    android:textColor="#1A0F33"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="HD  •  TUTORIAL"
                    android:textColor="#C4B5FD"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:background="@drawable/step_chip_violet"/>
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:text="— EIP TEAM —"
            android:textColor="#475569"
            android:textSize="11sp"
            android:letterSpacing="0.3"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
