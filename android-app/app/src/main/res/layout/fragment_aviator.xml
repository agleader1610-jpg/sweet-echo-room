<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060912"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ═════════════ EIP TEAM HEADER ═════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="#FFD54F"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="EIP TEAM • AVIATOR PRO"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.28"/>

            <TextView
                android:id="@+id/liveDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#1F2937"
                android:text="● LIVE"
                android:textColor="#4ADE80"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>
        </LinearLayout>

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="28dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#7A8899"
            android:text="Waiting for Aviator data…\nOpen the game in the DK Win tab."
            android:visibility="visible"/>

        <!-- ═════════════ HERO: PREDICTION SIGNAL (biggest, first) ═════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/predictionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#0A1428"
            app:cardCornerRadius="18dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Signal header: which round -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ EIP SIGNAL"
                        android:textColor="#FFD54F"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.28"/>
                    <TextView
                        android:id="@+id/predConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="#1F2937"
                        android:text="—"
                        android:textColor="#E2E8F0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"/>
                </LinearLayout>

                <!-- "FOR ROUND #123456" -->
                <TextView
                    android:id="@+id/predForRound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="FOR ROUND #—"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:fontFamily="monospace"/>

                <!-- BIG TARGET (hero) — this is the ONE thing users look at -->
                <TextView
                    android:id="@+id/predTargetBig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="—"
                    android:textColor="#4ADE80"
                    android:textSize="68sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"/>

                <!-- Action pill -->
                <TextView
                    android:id="@+id/predSignal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="ANALYZING…"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16"
                    android:background="#455A64"/>

                <TextView
                    android:id="@+id/predSuggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#D7DEE8"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:text=""/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="#1E293B"/>

                <!-- WIN / LOSS score bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginEnd="3dp"
                        android:background="#0F2318">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WIN"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#4ADE80"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/predWins"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="#4ADE80"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="#2A1414">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOSS"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#F87171"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/predLosses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="#F87171"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="#2A2410">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACC"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#FACC15"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/predAccuracy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#FACC15"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginStart="3dp"
                        android:background="#1E1A2E">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STREAK"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#A78BFA"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/predStreak"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#A78BFA"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Last result badge (compact) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/predResultBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:background="#1F2937"
                        android:text="◌ WAITING"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"/>

                    <TextView
                        android:id="@+id/predResultDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="—"
                        android:textColor="#B0BEC5"
                        android:textSize="11sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <!-- Mini stats: 10x gap / low streak / heat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10x GAP"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predDrought"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#F87171"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOW STREAK"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predLowStreak"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#FBBF24"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HEAT"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predHeat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#4ADE80"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="⚠ Prediction is a statistical hint from history, not a guarantee. Play responsibly."
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontStyle="italic"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═════════════ LAST CRASH (compact secondary card) ═════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/phaseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LAST CRASH"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.28"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/liveMultiplier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#E53935"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:text="—"/>

                    <TextView
                        android:id="@+id/roundLine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="6dp"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/phaseTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#78909C"
                    android:fontFamily="monospace"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/phaseBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/timingRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <TextView android:id="@+id/flyMsText"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                    <TextView android:id="@+id/waitMsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                    <TextView android:id="@+id/cyclesText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═════════════ HISTORY (secondary) ═════════════ -->
        <TextView
            android:id="@+id/historyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="◂ RECENT ROUNDS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#78909C"
            android:letterSpacing="0.22"
            android:visibility="gone"/>

        <HorizontalScrollView
            android:id="@+id/historyScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/historyStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Hidden analysis card (kept for binding refs, not shown) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/analysisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/trendBadge"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statAvg"       android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statMax"       android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statMin"       android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statLowCount"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statMidCount"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statHighCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/streakText"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/roundsText"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═════════════ BROWSER OVERLAY TOGGLE ═════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#111C33"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BROWSER TAB OVERLAY"
                        android:textColor="#FFD54F"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.2"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Show live signal card on the game screen"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/overlaySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_gravity="end"
            android:text="Clear"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
