<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ═════════════ EIP TEAM HEADER ═════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="#22D3EE"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="EIP TEAM • AVIATOR PRO"
                android:textColor="#22D3EE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.28"/>

            <TextView
                android:id="@+id/liveDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#1F2937"
                android:text="● LIVE"
                android:textColor="#4ADE80"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>
        </LinearLayout>

        <!-- ═════════════ BROWSER OVERLAY TOGGLE (moved to top) ═════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#111C33"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BROWSER TAB OVERLAY"
                        android:textColor="#22D3EE"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.2"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Show live signal card on the game screen"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/overlaySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="28dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#7A8899"
            android:text="Waiting for Aviator data…\nOpen the game in the DK Win tab."
            android:visibility="visible"/>

        <!-- ═════════════ HERO: PREDICTION SIGNAL (compact & advanced) ═════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/predictionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#0A0F1E"
            app:cardCornerRadius="16dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:background="#22D3EE"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="EIP SIGNAL"
                        android:textColor="#22D3EE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.3"/>
                    <TextView
                        android:id="@+id/predForRound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="#—"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:fontFamily="@font/roboto_mono"/>
                    <TextView
                        android:id="@+id/predConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="#1F2937"
                        android:text="—"
                        android:textColor="#E2E8F0"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:id="@+id/predSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="#1F2937"
                        android:text="⚙ LOCAL"
                        android:textColor="#94A3B8"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"/>
                    <TextView
                        android:id="@+id/predLatency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:textColor="#546A85"
                        android:textSize="9sp"
                        android:fontFamily="@font/roboto_mono"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/predTargetBig"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textColor="#4ADE80"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.03"
                        android:fontFamily="@font/orbitron"
                        android:includeFontPadding="false"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:id="@+id/predSignal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="ANALYZING"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.18"
                            android:background="#455A64"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_gravity="end"
                            android:text="CASH OUT"
                            android:textColor="#64748B"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.24"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/predSuggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:text=""/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:paddingTop="8dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:background="#111A2E">
                    <TextView
                        android:id="@+id/predDrought"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="—"
                        android:textColor="#F87171"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:fontFamily="@font/roboto_mono"/>
                    <TextView
                        android:id="@+id/predLowStreak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="—"
                        android:textColor="#FBBF24"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:fontFamily="@font/roboto_mono"/>
                    <TextView
                        android:id="@+id/predHeat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="—"
                        android:textColor="#4ADE80"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:fontFamily="@font/roboto_mono"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#111A2E"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="10x GAP"
                        android:textColor="#546A85" android:textSize="8sp"
                        android:textStyle="bold" android:letterSpacing="0.16"/>
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="LOW RUN"
                        android:textColor="#546A85" android:textSize="8sp"
                        android:textStyle="bold" android:letterSpacing="0.16"/>
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="HEAT"
                        android:textColor="#546A85" android:textSize="8sp"
                        android:textStyle="bold" android:letterSpacing="0.16"/>
                </LinearLayout>

                <!-- ═════════════ W/L SCORECARD (main tab only) ═════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:background="#0A0F1E"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/predWins"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="#4ADE80"
                            android:textSize="20sp" android:textStyle="bold"
                            android:fontFamily="@font/orbitron"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="WINS" android:textColor="#4ADE80"
                            android:textSize="8sp" android:textStyle="bold"
                            android:letterSpacing="0.2"/>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1E293B"/>

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/predLosses"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="#F87171"
                            android:textSize="20sp" android:textStyle="bold"
                            android:fontFamily="@font/orbitron"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="LOSS" android:textColor="#F87171"
                            android:textSize="8sp" android:textStyle="bold"
                            android:letterSpacing="0.2"/>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1E293B"/>

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/predAccuracy"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="#22D3EE"
                            android:textSize="20sp" android:textStyle="bold"
                            android:fontFamily="@font/orbitron"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ACC" android:textColor="#22D3EE"
                            android:textSize="8sp" android:textStyle="bold"
                            android:letterSpacing="0.2"/>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1E293B"/>

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/predStreak"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="#E2E8F0"
                            android:textSize="20sp" android:textStyle="bold"
                            android:fontFamily="@font/orbitron"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="STREAK" android:textColor="#94A3B8"
                            android:textSize="8sp" android:textStyle="bold"
                            android:letterSpacing="0.2"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- LAST RESULT badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/predResultBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="4dp" android:paddingBottom="4dp"
                        android:background="#1F2937"
                        android:text="—"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"/>
                    <TextView
                        android:id="@+id/predResultDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:fontFamily="@font/roboto_mono"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═════════════ LAST CRASH (compact secondary card) ═════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/phaseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LAST CRASH"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.28"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/liveMultiplier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#E53935"
                        android:fontFamily="@font/orbitron"
                        android:includeFontPadding="false"
                        android:text="—"/>

                    <TextView
                        android:id="@+id/roundLine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="6dp"
                        android:textSize="11sp"
                        android:textColor="#64748B"
                        android:fontFamily="@font/roboto_mono"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/phaseTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#78909C"
                    android:fontFamily="@font/roboto_mono"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/phaseBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/timingRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <TextView android:id="@+id/flyMsText"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                    <TextView android:id="@+id/waitMsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                    <TextView android:id="@+id/cyclesText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═════════════ HISTORY (secondary) ═════════════ -->
        <TextView
            android:id="@+id/historyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="◂ RECENT ROUNDS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#78909C"
            android:letterSpacing="0.22"
            android:visibility="gone"/>

        <HorizontalScrollView
            android:id="@+id/historyScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/historyStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Hidden analysis card (kept for binding refs, not shown) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/analysisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/trendBadge"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statAvg"       android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statMax"       android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statMin"       android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statLowCount"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statMidCount"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/statHighCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/streakText"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
                <TextView android:id="@+id/roundsText"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═════════════ DEBUG PANEL (temporary, remove for production) ═════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#0B1220"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View android:layout_width="3dp" android:layout_height="12dp" android:background="#F59E0B"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="🔧 DEBUG • AI DIAGNOSTICS"
                        android:textColor="#F59E0B"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.25"/>
                    <TextView
                        android:id="@+id/debugStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDLE"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="#1F2937"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1F2937" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:text="History top → Predict for"/>
                    <TextView
                        android:id="@+id/debugRoundLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#E2E8F0"
                        android:text="—"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/debugMatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#4ADE80"
                    android:text=""/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:text="Source / Model"/>
                    <TextView
                        android:id="@+id/debugModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#E2E8F0"
                        android:text="—"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:text="Latency / Prediction ID"/>
                    <TextView
                        android:id="@+id/debugLatencyId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#E2E8F0"
                        android:text="—"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI REASONING"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/debugReasoning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:padding="8dp"
                    android:background="#0F172A"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0"
                    android:text="—"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="RAW AI RESPONSE"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:letterSpacing="0.2"
                    android:textStyle="bold"/>
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#0F172A"
                    android:scrollbars="horizontal">
                    <TextView
                        android:id="@+id/debugRawAi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:fontFamily="@font/roboto_mono"
                        android:textSize="10sp"
                        android:textColor="#93C5FD"
                        android:text="(no response yet)"/>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/debugError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#3F1D1D"
                    android:textSize="11sp"
                    android:textColor="#FCA5A5"
                    android:visibility="gone"
                    android:text=""/>

                <TextView
                    android:id="@+id/debugFetchLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="10sp"
                    android:textColor="#64748B"
                    android:text=""/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═════════════ SIGNAL HISTORY (local, per-user) ═════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/signalHistoryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0A0F1E"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="◂ SIGNAL HISTORY"
                        android:textColor="#22D3EE"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.22"/>
                    <TextView
                        android:id="@+id/signalHistoryStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto_mono"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:paddingBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:text="ROUND"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TARGET"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CRASH"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:gravity="end"
                        android:text="RESULT"
                        android:textColor="#64748B"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1F2937"/>

                <LinearLayout
                    android:id="@+id/signalHistoryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_gravity="end"
            android:text="Clear"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
