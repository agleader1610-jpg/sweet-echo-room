<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ═════════════ VIP TEAM HEADER ═════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="#FFD54F"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="EIP TEAM • AVIATOR"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.28"/>

            <TextView
                android:id="@+id/liveDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="#1F2937"
                android:text="● LIVE"
                android:textColor="#4ADE80"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>
        </LinearLayout>

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="28dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#7A8899"
            android:text="Waiting for Aviator data…\nOpen the game in the DK Win tab."
            android:visibility="visible"/>

        <!-- ═════════════ 1. PREVIOUS ROUNDS HISTORY ═════════════ -->
        <TextView
            android:id="@+id/historyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="◂ PREVIOUS ROUNDS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#78909C"
            android:letterSpacing="0.22"
            android:visibility="gone"/>

        <HorizontalScrollView
            android:id="@+id/historyScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/historyStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- ═════════════ 2. CURRENT RUNNING ROUND (HERO) ═════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/phaseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CURRENT ROUND"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.28"/>

                    <TextView
                        android:id="@+id/phaseBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="IDLE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"
                        android:textColor="#FFFFFF"
                        android:background="#455A64"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/liveMultiplier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="62sp"
                    android:textStyle="bold"
                    android:textColor="#E53935"
                    android:text="—"/>

                <TextView
                    android:id="@+id/phaseTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:textSize="13sp"
                    android:textColor="#B0BEC5"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/roundLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:fontFamily="monospace"/>

                <!-- BET / FLY / CYCLE tiles inside the hero -->
                <LinearLayout
                    android:id="@+id/timingRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BET"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#4ADE80"
                            android:letterSpacing="0.22"/>
                        <TextView
                            android:id="@+id/flyMsText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#ECEFF1"
                            android:fontFamily="monospace"
                            android:text="—"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FLY"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFB74D"
                            android:letterSpacing="0.22"/>
                        <TextView
                            android:id="@+id/waitMsText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#ECEFF1"
                            android:fontFamily="monospace"
                            android:text="—"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CYCLES"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#64B5F6"
                            android:letterSpacing="0.22"/>
                        <TextView
                            android:id="@+id/cyclesText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#ECEFF1"
                            android:fontFamily="monospace"
                            android:text="0"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═════════════ PREDICTION SIGNAL ═════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/predictionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="◈ EIP PREDICTION SIGNAL"
                        android:textColor="#FFD54F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.24"/>
                    <TextView
                        android:id="@+id/predConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="#1F2937"
                        android:text="—"
                        android:textColor="#E2E8F0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/predSignal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="14dp"
                    android:gravity="center"
                    android:text="ANALYZING…"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:background="#455A64"/>

                <TextView
                    android:id="@+id/predSuggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:text=""/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#1E293B"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DROUGHT"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predDrought"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#F87171"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOW STREAK"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predLowStreak"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#FBBF24"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HEAT"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predHeat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#4ADE80"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- ── WIN DETECTOR ── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#1E293B"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/predResultBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:background="#1F2937"
                        android:text="◌ WAITING"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"/>

                    <TextView
                        android:id="@+id/predResultDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="—"
                        android:textColor="#B0BEC5"
                        android:textSize="11sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginEnd="3dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WIN"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#4ADE80"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predWins"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="#4ADE80"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOSS"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#F87171"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predLosses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="#F87171"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACC"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#FACC15"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predAccuracy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#FACC15"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginStart="3dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STREAK"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#A78BFA"
                            android:letterSpacing="0.18"/>
                        <TextView
                            android:id="@+id/predStreak"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#A78BFA"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="⚠ Prediction is a statistical hint from history, not a guarantee. Play responsibly."
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontStyle="italic"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>



        <!-- ═════════════ 3. DEEP ANALYSIS ═════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/analysisCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ANALYSIS • LAST 20"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.28"/>
                    <TextView
                        android:id="@+id/trendBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="#1F2937"
                        android:text="—"
                        android:textColor="#E2E8F0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVG"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/statAvg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#FACC15"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MAX"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/statMax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#A78BFA"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginStart="6dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MIN"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#94A3B8"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/statMin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            android:textColor="#F87171"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOW &lt;2x"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#F87171"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/statLowCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="#ECEFF1"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MID 2-10x"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#4ADE80"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/statMidCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="#ECEFF1"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginStart="6dp"
                        android:background="#111C33">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HIGH ≥10x"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#A78BFA"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/statHighCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="#ECEFF1"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/streakText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="10dp"
                    android:background="#111C33"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:text="—"/>

                <!-- Legacy history (kept for detail) -->
                <TextView
                    android:id="@+id/roundsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="10dp"
                    android:background="#0B1428"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:text="(none)"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═════════════ BROWSER OVERLAY TOGGLE ═════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#111C33"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BROWSER TAB OVERLAY"
                        android:textColor="#FFD54F"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.2"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Show compact current + previous round on the game screen"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/overlaySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_gravity="end"
            android:text="Clear"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
