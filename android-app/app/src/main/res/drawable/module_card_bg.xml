<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#0F1830"
                android:centerColor="#0A0F1E"
                android:endColor="#141026"/>
            <stroke android:width="1dp" android:color="#1E2A44"/>
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:centerX="0.15" android:centerY="0.1"
                android:startColor="#3322D3EE"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
