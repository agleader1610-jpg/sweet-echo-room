<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:type="linear" android:angle="135"
                android:startColor="#FF1A1004" android:centerColor="#FF2A1808" android:endColor="#FF0A0A0A"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:type="radial" android:gradientRadius="220dp"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#44F59E0B" android:endColor="#00000000"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#55F59E0B"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>
