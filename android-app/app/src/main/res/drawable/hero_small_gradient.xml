<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res-auto">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#22D3EE"
                android:centerColor="#3B82F6"
                android:endColor="#6366F1"/>
            <stroke android:width="1dp" android:color="#66FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="0.2" android:centerY="0.15"
                android:startColor="#55FFFFFF"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
