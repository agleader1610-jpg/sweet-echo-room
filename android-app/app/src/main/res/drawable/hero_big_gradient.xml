<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF9500"
                android:centerColor="#FB7185"
                android:endColor="#F43F5E"/>
            <stroke android:width="1dp" android:color="#66FFFFFF"/>
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp"/>
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="0.2" android:centerY="0.15"
                android:startColor="#55FFFFFF"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
