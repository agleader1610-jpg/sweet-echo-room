<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <gradient android:type="linear" android:angle="90"
                android:startColor="#FF0A0F1E" android:endColor="#FF0F1B33"/>
            <stroke android:width="1dp" android:color="#33F59E0B"/>
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#FFF59E0B"/>
        </shape>
    </item>
</layer-list>
