<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer neon halo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#5522D3EE"
                android:centerColor="#33A855F7"
                android:endColor="#55A855F7"/>
        </shape>
    </item>
    <!-- Inner dark canvas -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#080D1C"
                android:endColor="#05070F"/>
        </shape>
    </item>
</layer-list>
