<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:type="linear" android:angle="135"
                android:startColor="#FF120826" android:centerColor="#FF1E0F3A" android:endColor="#FF0A0514"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:type="radial" android:gradientRadius="220dp"
                android:centerX="0.5" android:centerY="0.5"
                android:startColor="#44A78BFA" android:endColor="#00000000"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#55A78BFA"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>
